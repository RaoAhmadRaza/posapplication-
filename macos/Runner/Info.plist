<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Voice search (speech_to_text) needs mic + speech recognition access. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Voice search uses the microphone to let you speak a product name.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Voice search converts your speech to text to find products.</string>
	<!-- Opt out of the experimental merged platform/UI thread. The printing
	     plugin presents a native modal (NSPrintOperation) that runs a nested
	     run loop on the platform thread; under the merged thread that deadlocks
	     and Printing.layoutPdf never returns (spinner hangs forever). -->
	<key>FLTEnableMergedPlatformUIThread</key>
	<false/>
</dict>
</plist>
